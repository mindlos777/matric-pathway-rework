        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "Pathly.apk"
    },
    "web": {
      "favicon": "./assets/logo_v1.png"
    },
    "plugins": [
      "expo-font"
    ],
    "owner": "mindlos777s-organization",
    "extra": {
      "eas": {
        "projectId": "010b6648-c7e5-4069-9363-2b4b46119c04"
      }
    }
  }
}
